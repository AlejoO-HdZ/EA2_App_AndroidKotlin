<?xml version="1.0" encoding="utf-8"?>

<!-- Pantalla inicial de bienvenida de la aplicación -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B5DBFB"
    tools:context=".Bienvenida">

    <TextView
        android:id="@+id/tituloBienvenida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="156dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="BIENVENIDA"
        android:textColor="#173F5F"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ícono incluido en la plantilla estándar de Android Studio -->
    <ImageView
        android:id="@+id/iconoTelefono"
        android:layout_width="85dp"
        android:layout_height="76dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Ícono de teléfono"
        android:src="@drawable/ic_launcher_foreground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloBienvenida"
        app:tint="#168A8A" />

    <TextView
        android:id="@+id/nombreApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="App Móvil"
        android:textColor="#245A7A"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconoTelefono" />

    <!-- Descripción de la aplicación -->
    <TextView
        android:id="@+id/descripcionApp"
        android:layout_width="328dp"
        android:layout_height="150dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="35dp"
        android:gravity="center"
        android:text="Taller Práctica Android&#10;&#10;Comunicación entre actividades"
        android:textColor="#52718A"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nombreApp" />

    <!-- Botón para entrar a la actividad principal -->
    <Button
        android:id="@+id/btnComenzar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:backgroundTint="#168A8A"
        android:text="COMENZEMOS ->"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/descripcionApp" />

</androidx.constraintlayout.widget.ConstraintLayout>
