<?xml version="1.0" encoding="utf-8"?>

<!-- Interfaz principal orientación horizontal -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DCEEFF"
    tools:context=".MainActivity">

    <!-- Título de la actividad principal -->
    <TextView
        android:id="@+id/tituloMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="ACTIVITY MAIN (Modo Horizontal)"
        android:textColor="#173F5F"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Texto descriptivo -->
    <TextView
        android:id="@+id/subtituloMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="30dp"
        android:gravity="left"
        android:text="Envía un mensaje a la segunda actividad:"
        android:textColor="#52718A"
        android:textSize="15sp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloMain" />

    <!-- Campo para escribir el mensaje -->
    <EditText
        android:id="@+id/editMensaje"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="30dp"
        android:backgroundTint="#4A90E2"
        android:gravity="top|start"
        android:hint="Escribe tu mensaje..."
        android:inputType="textCapSentences|textMultiLine"
        android:overScrollMode="ifContentScrolls"
        android:padding="14dp"
        android:scrollbars="vertical"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtituloMain" />

    <!-- Botón para enviar el mensaje -->
    <Button
        android:id="@+id/btnEnviar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#4A90E2"
        android:text="ENVIAR MENSAJE"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editMensaje" />

    <!-- Cuadro donde se muestra el estado y el mensaje -->
    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="30dp"
        android:background="#C8E2F8"
        android:gravity="center"
        android:padding="12dp"
        android:text="ESTADO: ESPERANDO"
        android:textColor="#173F5F"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEnviar" />

    <!-- Botón para cerrar la aplicación -->
    <Button
        android:id="@+id/btnSalir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#6B7280"
        android:text="SALIR DE APLICACIÓN"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtEstado" />

</androidx.constraintlayout.widget.ConstraintLayout>
